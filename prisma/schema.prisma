// ============================================
// PRISMA SCHEMA - Trinity Party
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIO ADMIN (para login del panel)
// ============================================
model Usuario {
  id_usuario         Int            @id @default(autoincrement())
  nombre             String         @db.VarChar(150)
  apellido           String?        @db.VarChar(150)
  email              String         @unique @db.VarChar(150)
  telefono           String?        @unique @db.VarChar(20)
  password           String?        @db.VarChar(255) // hash bcrypt
  avatarUrl          String?        @map("avatar_url") @db.VarChar(500)
  rol                RolUsuario     @default(ADMIN)
  estado             EstadoGenerico @default(Activo)
  emailVerificado    Boolean        @default(false) @map("email_verificado")
  telefonoVerificado Boolean        @default(false) @map("telefono_verificado")
  fechaRegistro      DateTime       @default(now()) @map("fecha_registro")
  fechaActualizacion DateTime       @default(now()) @updatedAt @map("fecha_actualizacion")

  movimientosInventario MovimientoInventario[]
  carrito               Carrito?
  pedidos               Pedido[]
  cuentasAuth           AuthAccount[]

  @@map("usuario")
}

enum ProveedorAuth {
  LOCAL
  GOOGLE
}

model AuthAccount {
  idAuthAccount  Int           @id @default(autoincrement()) @map("id_auth_account")
  idUsuario      Int           @map("id_usuario")
  provider       ProveedorAuth
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  fechaCreacion  DateTime      @default(now()) @map("fecha_creacion")

  usuario Usuario @relation(fields: [idUsuario], references: [id_usuario], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([idUsuario])
  @@map("auth_account")
}

enum RolUsuario {
  ADMIN
  EMPLEADO
  CLIENTE
}

enum EstadoGenerico {
  Activo
  Inactivo
}

enum TipoVisualizacionAtributo {
  text
  color
  image
}

// ============================================
// CATEGORIA (árbol de categorías)
// ============================================
model Categoria {
  idCategoria      Int            @id @default(autoincrement()) @map("id_categoria")
  idCategoriaPadre Int?           @map("id_categoria_padre")
  nombre           String         @unique @db.VarChar(100)
  slug             String         @unique @db.VarChar(150)
  descripcion      String?        @db.Text
  imagenPublicId   String?        @map("imagen_public_id") @db.VarChar(255)
  imagenUrl        String?        @map("imagen_url") @db.VarChar(500)
  orden            Int            @default(0)
  estado           EstadoGenerico @default(Activo)

  categoriaPadre Categoria?  @relation("CategoriaPadre", fields: [idCategoriaPadre], references: [idCategoria])
  subcategorias  Categoria[] @relation("CategoriaPadre")
  productos      Producto[]

  @@map("categoria")
}

// ============================================
// MARCA
// ============================================
model Marca {
  idMarca   Int                @id @default(autoincrement()) @map("id_marca")
  nombre    String             @unique @db.VarChar(100)
  variantes ProductoVariante[]

  @@map("marca")
}

// ============================================
// UNIDAD DE MEDIDA
// ============================================
model UnidadMedida {
  idUnidad    Int                @id @default(autoincrement()) @map("id_unidad")
  nombre      String             @db.VarChar(50)
  abreviatura String             @db.VarChar(10)
  variantes   ProductoVariante[]

  @@map("unidad_medida")
}

// ============================================
// PROVEEDOR
// ============================================
model Proveedor {
  idProveedor Int     @id @default(autoincrement()) @map("id_proveedor")
  nombre      String  @db.VarChar(150)
  telefono    String? @db.VarChar(20)
  correo      String? @db.VarChar(150)

  varianteProveedor VarianteProveedor[]

  @@map("proveedor")
}

// ============================================
// ATRIBUTO / VALOR_ATRIBUTO
// ============================================
model Atributo {
  idAtributo        Int                       @id @default(autoincrement()) @map("id_atributo")
  nombre            String                    @unique @db.VarChar(100)
  tipoVisualizacion TipoVisualizacionAtributo @default(text) @map("tipo_visualizacion")

  valores                ValorAtributo[]
  productosComoPrincipal Producto[]      @relation("AtributoPrincipalProducto")

  @@map("atributo")
}

model ValorAtributo {
  idValor     Int     @id @default(autoincrement()) @map("id_valor")
  idAtributo  Int     @map("id_atributo")
  valor       String  @db.VarChar(100)
  visualValue String? @map("visual_value") @db.VarChar(255)

  atributo         Atributo           @relation(fields: [idAtributo], references: [idAtributo], onDelete: Cascade)
  varianteAtributo VarianteAtributo[]

  @@map("valor_atributo")
}

// ============================================
// PRODUCTO
// ============================================
model Producto {
  idProducto          Int            @id @default(autoincrement()) @map("id_producto")
  idCategoria         Int            @map("id_categoria")
  idAtributoPrincipal Int?           @map("id_atributo_principal")
  nombre              String         @db.VarChar(150)
  slug                String         @unique @db.VarChar(180)
  rating              Decimal        @default(4.0) @db.Decimal(2, 1) //agregando rating promedio de 1 a 5
  descripcionCorta    String?        @map("descripcion_corta") @db.VarChar(255)
  descripcion         String?        @db.Text
  destacado           Boolean        @default(false)
  metaTitulo          String?        @map("meta_titulo") @db.VarChar(160)
  metaDescripcion     String?        @map("meta_descripcion") @db.VarChar(255)
  estado              EstadoProducto @default(Borrador)
  fechaRegistro       DateTime       @default(now()) @map("fecha_registro")
  fechaActualizacion  DateTime       @default(now()) @updatedAt @map("fecha_actualizacion")
  fechaPublicacion    DateTime?      @map("fecha_publicacion")

  categoria         Categoria          @relation(fields: [idCategoria], references: [idCategoria])
  atributoPrincipal Atributo?          @relation("AtributoPrincipalProducto", fields: [idAtributoPrincipal], references: [idAtributo], onDelete: SetNull)
  imagenes          ImagenProducto[]
  variantes         ProductoVariante[]

  @@index([idCategoria])
  @@index([idAtributoPrincipal])
  @@map("producto")
}

enum EstadoProducto {
  Borrador
  Activo
  Inactivo
  Descontinuado
}

// ============================================
// IMAGEN_PRODUCTO (Cloudinary)
// ============================================
model ImagenProducto {
  idImagen    Int     @id @default(autoincrement()) @map("id_imagen")
  idProducto  Int     @map("id_producto")
  publicId    String  @map("public_id") @db.VarChar(255)
  url         String  @db.VarChar(500)
  principal   Boolean @default(false)
  ordenImagen Int     @default(1) @map("orden_imagen")

  producto Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)

  @@map("imagen_producto")
}

// ============================================
// PRODUCTO_VARIANTE
// ============================================
model ProductoVariante {
  idVariante        Int            @id @default(autoincrement()) @map("id_variante")
  idProducto        Int            @map("id_producto")
  idMarca           Int?           @map("id_marca")
  idUnidad          Int?           @map("id_unidad")
  cantidadContenido Decimal        @default(1.00) @map("cantidad_contenido") @db.Decimal(10, 2)
  sku               String         @unique @db.VarChar(50)
  codigoBarras      String?        @unique @map("codigo_barras") @db.VarChar(100)
  precioVenta       Decimal        @map("precio_venta") @db.Decimal(10, 2)
  precioOferta      Decimal?       @map("precio_oferta") @db.Decimal(10, 2)
  peso              Decimal?       @db.Decimal(10, 2)
  estado            EstadoGenerico @default(Activo)

  producto Producto      @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)
  marca    Marca?        @relation(fields: [idMarca], references: [idMarca])
  unidad   UnidadMedida? @relation(fields: [idUnidad], references: [idUnidad])

  imagenes              ImagenVariante[]
  inventario            Inventario?
  varianteAtributo      VarianteAtributo[]
  varianteProveedor     VarianteProveedor[]
  movimientosInventario MovimientoInventario[]
  carritoItems          CarritoDetalle[]
  pedidoItems           PedidoDetalle[]

  @@index([idProducto])
  @@map("producto_variante")
}

// ============================================
// IMAGEN_VARIANTE (Cloudinary)
// ============================================
model ImagenVariante {
  idImagen    Int     @id @default(autoincrement()) @map("id_imagen")
  idVariante  Int     @map("id_variante")
  publicId    String  @map("public_id") @db.VarChar(255)
  url         String  @db.VarChar(500)
  principal   Boolean @default(false)
  ordenImagen Int     @default(1) @map("orden_imagen")

  variante ProductoVariante @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade)

  @@map("imagen_variante")
}

// ============================================
// INVENTARIO (1 a 1 con variante)
// ============================================
model Inventario {
  idInventario Int  @id @default(autoincrement()) @map("id_inventario")
  idVariante   Int  @unique @map("id_variante")
  stockActual  Int  @default(0) @map("stock_actual")
  stockMinimo  Int  @default(0) @map("stock_minimo")
  stockMaximo  Int? @map("stock_maximo")

  variante ProductoVariante @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade)

  @@map("inventario")
}

// ============================================
// MOVIMIENTO_INVENTARIO (historial de movimientos de stock)
// ============================================
enum TipoMovimiento {
  Entrada
  Salida
  Ajuste
}

model MovimientoInventario {
  idMovimiento  Int            @id @default(autoincrement()) @map("id_movimiento")
  idVariante    Int            @map("id_variante")
  tipo          TipoMovimiento
  cantidad      Int
  stockAnterior Int            @map("stock_anterior")
  stockNuevo    Int            @map("stock_nuevo")
  motivo        String?        @db.VarChar(255)
  idUsuario     Int?           @map("id_usuario")
  fecha         DateTime       @default(now())

  variante ProductoVariante @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade)
  usuario  Usuario?         @relation(fields: [idUsuario], references: [id_usuario])

  @@index([idVariante, fecha])
  @@map("movimiento_inventario")
}

// ============================================
// VARIANTE_ATRIBUTO (N a N)
// ============================================
model VarianteAtributo {
  idVariante Int @map("id_variante")
  idValor    Int @map("id_valor")

  variante      ProductoVariante @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade)
  valorAtributo ValorAtributo    @relation(fields: [idValor], references: [idValor], onDelete: Cascade)

  @@id([idVariante, idValor])
  @@map("variante_atributo")
}

// ============================================
// VARIANTE_PROVEEDOR (N a N con precio de compra)
// ============================================
model VarianteProveedor {
  idVariante   Int      @map("id_variante")
  idProveedor  Int      @map("id_proveedor")
  precioCompra Decimal? @map("precio_compra") @db.Decimal(10, 2)

  variante  ProductoVariante @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade)
  proveedor Proveedor        @relation(fields: [idProveedor], references: [idProveedor], onDelete: Cascade)

  @@id([idVariante, idProveedor])
  @@map("variante_proveedor")
}

// ============================================
// CARRITO
// ============================================
model Carrito {
  idCarrito     Int      @id @default(autoincrement()) @map("id_carrito")
  idUsuario     Int      @unique @map("id_usuario")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  usuario Usuario          @relation(fields: [idUsuario], references: [id_usuario])
  items   CarritoDetalle[]

  @@map("carrito")
}

model CarritoDetalle {
  idDetalle  Int @id @default(autoincrement()) @map("id_detalle")
  idCarrito  Int @map("id_carrito")
  idVariante Int @map("id_variante")
  cantidad   Int @default(1)

  carrito  Carrito          @relation(fields: [idCarrito], references: [idCarrito], onDelete: Cascade)
  variante ProductoVariante @relation(fields: [idVariante], references: [idVariante])

  @@unique([idCarrito, idVariante])
  @@map("carrito_detalle")
}

// ============================================
// PEDIDO
// ============================================
enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

model Pedido {
  idPedido         Int          @id @default(autoincrement()) @map("id_pedido")
  idUsuario        Int          @map("id_usuario")
  estado           EstadoPedido @default(PENDIENTE)
  total            Decimal      @db.Decimal(10, 2)
  nombreContacto   String       @map("nombre_contacto") @db.VarChar(150)
  telefonoContacto String       @map("telefono_contacto") @db.VarChar(50)
  direccionEntrega String?      @map("direccion_entrega") @db.VarChar(255)
  notas            String?      @db.Text
  fechaCreacion    DateTime     @default(now()) @map("fecha_creacion")

  usuario Usuario         @relation(fields: [idUsuario], references: [id_usuario])
  items   PedidoDetalle[]

  @@index([idUsuario, fechaCreacion])
  @@map("pedido")
}

model PedidoDetalle {
  idDetalle      Int     @id @default(autoincrement()) @map("id_detalle")
  idPedido       Int     @map("id_pedido")
  idVariante     Int     @map("id_variante")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)

  pedido   Pedido           @relation(fields: [idPedido], references: [idPedido], onDelete: Cascade)
  variante ProductoVariante @relation(fields: [idVariante], references: [idVariante])

  @@map("pedido_detalle")
}
